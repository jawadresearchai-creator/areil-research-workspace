{
  "areil-integrity-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".agents/hooks/research-integrity-guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "areil-tool-provenance": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".agents/hooks/tool-event-log.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
